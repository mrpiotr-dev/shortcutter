{
  "name": "shortcutter",
  "version": "0.2.0",
  "description": "Tiny, dependency-free keyboard shortcuts with contexts and key phases. SSR-safe.",
  "keywords": [
    "hotkey",
    "hotkeys",
    "key-binding",
    "keyboard",
    "keydown",
    "keypress",
    "keyup",
    "shortcut",
    "shortcuts"
  ],
  "homepage": "https://www.shortcutter.dev/",
  "bugs": {
    "url": "https://github.com/mrpiotr-dev/shortcutter/issues"
  },
  "license": "MIT",
  "author": "Piotr Laszczkowski <contact@mrpiotr.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpiotr-dev/shortcutter.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "test:coverage": "vp test --coverage",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
