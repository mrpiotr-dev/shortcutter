{
  "name": "shortcutter",
  "version": "0.2.0",
  "description": "Tiny, dependency-free library to manage keyboard shortcuts in your application.",
  "keywords": [
    "hotkey",
    "hotkeys",
    "key-binding",
    "keyboard",
    "keydown",
    "keypress",
    "keyup",
    "shortcut",
    "shortcuts"
  ],
  "homepage": "https://shortcutter.dev",
  "bugs": {
    "url": "https://github.com/mrpiotr-dev/shortcutter/issues"
  },
  "license": "MIT",
  "author": "Piotr Laszczkowski <contact@mrpiotr.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpiotr-dev/shortcutter.git",
    "directory": "packages/shortcutter"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./solid": {
      "import": "./dist/solid.js",
      "require": "./dist/solid.cjs"
    },
    "./svelte": {
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./vue": {
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "test:coverage": "vp test --coverage",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solid-js": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=5.29",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
