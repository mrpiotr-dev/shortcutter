{
  "name": "@shortcutter/svelte",
  "version": "0.2.0",
  "description": "Svelte 5 helpers and attachment for shortcutter keyboard shortcuts.",
  "keywords": [
    "hotkey",
    "hotkeys",
    "keyboard",
    "shortcut",
    "shortcuts",
    "svelte"
  ],
  "homepage": "https://www.shortcutter.dev/",
  "bugs": {
    "url": "https://github.com/mrpiotr-dev/shortcutter/issues"
  },
  "license": "MIT",
  "author": "Piotr Laszczkowski <contact@mrpiotr.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpiotr-dev/shortcutter.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "prepack": "cp ../../LICENSE ."
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@shortcutter/core": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@shortcutter/core": "workspace:^",
    "svelte": ">=5.29"
  }
}
