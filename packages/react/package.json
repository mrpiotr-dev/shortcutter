{
  "name": "@shortcutter/react",
  "version": "0.5.0",
  "description": "React hooks for shortcutter keyboard shortcuts.",
  "keywords": [
    "hotkey",
    "hotkeys",
    "keyboard",
    "react",
    "shortcut",
    "shortcuts"
  ],
  "homepage": "https://www.shortcutter.dev/",
  "bugs": {
    "url": "https://github.com/mrpiotr-dev/shortcutter/issues"
  },
  "license": "MIT",
  "author": "Piotr Laszczkowski <contact@mrpiotr.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpiotr-dev/shortcutter.git",
    "directory": "packages/react"
  },
  "funding": "https://github.com/sponsors/mrpiotr-dev",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "prepack": "cp ../../LICENSE ."
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shortcutter": "workspace:*",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "shortcutter": "workspace:^"
  }
}
