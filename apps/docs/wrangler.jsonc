// Static site on Cloudflare Workers (assets only, no Worker code).
// No account_id or secrets here: deploys run through Workers Builds (Git integration), which knows the account.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shortcutter-docs",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    // /docs → /docs/ (301), matching Astro's trailingSlash: 'always'.
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
  },
  // shortcutter.dev → www is a Cloudflare Redirect Rule (see README.md); the apex is attached
  // here only so Cloudflare creates its DNS record and certificate.
  "routes": [
    { "pattern": "www.shortcutter.dev", "custom_domain": true },
    { "pattern": "shortcutter.dev", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": true,
}
